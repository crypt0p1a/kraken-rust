# Copy to .env (ignored by git) and fill with a Kraken API key, for the live private tests:
#   cargo test -p kraken-api --test live_private -- --ignored --test-threads=1
#
# Permissions to give to the key: Query Funds, Query Open Orders & Trades,
# Query Closed Orders & Trades, Create & Modify Orders. Never Withdraw Funds.
# The tests are read only: the order they send is only validated (validate=true).
KRAKEN_API_KEY=
# the "Private Key" given by Kraken, in base64
KRAKEN_API_SECRET=
